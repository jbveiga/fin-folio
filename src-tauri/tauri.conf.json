{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FinFolio",
  "version": "2.0.0",
  "identifier": "com.finfolio.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "FinFolio — Local-First Personal Finance",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 640,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 18,
          "y": 18
        }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "public.app-category.finance",
    "shortDescription": "Local-First Personal Finance",
    "longDescription": "A high-performance, local-first, zero-knowledge personal finance application with deterministic statement ingestion.",
    "copyright": "Copyright © 2026 FinFolio Team",
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
